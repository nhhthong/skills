#!/usr/bin/env node
//
// A wizard walks a human through a manual procedure, step by step.
// Generated by the /dev:wizard skill. Run it with: node <this file>.mts
// Needs Node 22.18 or newer (runs TypeScript directly) and no packages.
//
// Everything above the "STAGES" marker is the wizard library: do not hand-edit
// it. Author the per-step stages below the marker.
import { execFileSync, spawnSync } from 'node:child_process';
import { chmodSync, existsSync, readFileSync, writeFileSync } from 'node:fs';
import { createInterface } from 'node:readline';
import type { Interface } from 'node:readline';

// ──────────────────────────────────────────────────────────────────────────
// Wizard library: delightful, consistent UX, identical across every wizard.
// ──────────────────────────────────────────────────────────────────────────

const color = process.stdout.isTTY && !process.env.NO_COLOR;
const sgr = (code: string): string => (color ? `\x1b[${code}m` : '');
const BOLD = sgr('1'), DIM = sgr('2'), RESET = sgr('0');
const BLUE = sgr('34'), GREEN = sgr('32'), YELLOW = sgr('33');

/** Author sets this at the top of the stages section. */
let totalStages = 0;
let stageIndex = 0;
const ENV_FILE = process.env.ENV_FILE ?? '.env';
const writtenEnv: string[] = [];    // KEYs written to ENV_FILE this run
const writtenSecret: string[] = []; // secret NAMEs set this run
const skipped: string[] = [];       // things we couldn't do (e.g. gh missing)

const out = (s: string): void => { process.stdout.write(s); };

// ---- line input ---------------------------------------------------------
// One readline interface for visible input. EOF resolves to null.
let rl: Interface | null = null;
let eof = false;
const queue: string[] = [];
let waiting: ((line: string | null) => void) | null = null;

function lines(): Interface {
  if (rl) return rl;
  rl = createInterface({ input: process.stdin, terminal: false });
  rl.on('line', (line) => {
    if (waiting) { const w = waiting; waiting = null; w(line); } else queue.push(line);
  });
  rl.on('close', () => {
    eof = true;
    if (waiting) { const w = waiting; waiting = null; w(null); }
  });
  return rl;
}

/** Read one line; null at end of input. */
function readLine(prompt: string): Promise<string | null> {
  lines();
  out(prompt);
  if (queue.length) return Promise.resolve(queue.shift() as string);
  if (eof) return Promise.resolve(null);
  return new Promise((resolve) => { waiting = resolve; });
}

/** Read one line without echo. Falls back to a visible read when stdin is not a terminal. */
async function readHidden(prompt: string): Promise<string | null> {
  if (!process.stdin.isTTY) return readLine(prompt);
  rl?.close(); rl = null; eof = false;
  out(prompt);
  return new Promise((resolve) => {
    let buf = '';
    const stdin = process.stdin;
    stdin.setRawMode(true); stdin.resume(); stdin.setEncoding('utf8');
    const done = (v: string | null): void => {
      stdin.setRawMode(false); stdin.pause(); stdin.off('data', onData); out('\n'); resolve(v);
    };
    const onData = (chunk: string): void => {
      for (const ch of chunk) {
        if (ch === '\r' || ch === '\n') return done(buf);
        if (ch === '\x03') { stdin.setRawMode(false); out('\n'); process.exit(130); }
        if (ch === '\x04') return done(buf ? buf : null);
        if (ch === '\x7f' || ch === '\b') buf = buf.slice(0, -1); else buf += ch;
      }
    };
    stdin.on('data', onData);
  });
}

// ---- output helpers -----------------------------------------------------

/** Wipe the terminal so only the current step is on screen. No-op when output is piped. */
function clear(): void {
  if (process.stdout.isTTY) out('\x1b[2J\x1b[3J\x1b[H');
}

/** banner("Title") shows the opening frame: what this wizard does. */
async function banner(title: string): Promise<void> {
  clear();
  out(`\n${BOLD}${BLUE}  ${title}${RESET}\n`);
  out(`${DIM}  ${totalStages} stages${RESET}\n\n`);
  out(`${DIM}  You drive the browser; this wizard tells you exactly what to do and\n`);
  out('  captures the values you copy back. Stop any time with Ctrl-C and re-run\n');
  out(`  later, since it remembers values already saved.${RESET}\n`);
  await pause('Ready to start?');
}

/** stage("Name") clears the screen, then announces a stage and shows progress. */
function stage(name: string): void {
  clear();
  stageIndex += 1;
  out(`\n${BOLD}${BLUE}▸ Stage ${stageIndex}/${totalStages} · ${name}${RESET}\n`);
}

/** say prints a plain instruction line. */
const say = (s: string): void => out(`  ${s}\n`);
/** step is an action the human takes in the browser. */
const step = (s: string): void => out(`  ${BLUE}•${RESET} ${s}\n`);
const note = (s: string): void => out(`  ${DIM}${s}${RESET}\n`);
const warn = (s: string): void => out(`  ${YELLOW}⚠ ${s}${RESET}\n`);

/** openUrl opens a URL in the human's browser, cross-platform incl. WSL. Only prints it when stdin is not a terminal or WIZARD_NO_OPEN is set. */
function openUrl(url: string): void {
  if (!process.stdin.isTTY || process.env.WIZARD_NO_OPEN) {
    out(`  ${GREEN}↗ open this${RESET} ${url}\n`); // piped or scripted run: no human at the terminal
    return;
  }
  out(`  ${GREEN}↗ opening${RESET} ${url}\n`);
  const candidates: [string, string[]][] = process.platform === 'win32'
    ? [['cmd', ['/c', 'start', '', url]]]
    : [['wslview', [url]], ['explorer.exe', [url]], ['xdg-open', [url]], ['open', [url]]];
  for (const [cmd, args] of candidates) {
    const r = spawnSync(cmd, args, { stdio: 'ignore' });
    if (!r.error) return;
  }
  warn(`couldn't open a browser, so visit it manually: ${url}`);
}

/** pause waits for the human to confirm they've done the manual part. */
async function pause(msg = 'Press Enter to continue'): Promise<void> {
  await readLine(`  ${DIM}${msg}${RESET} `);
}

/** confirm is a y/N gate; resolves true on yes. */
async function confirm(question: string): Promise<boolean> {
  const reply = await readLine(`  ${YELLOW}? ${question} [y/N] ${RESET}`);
  return /^[Yy]/.test(reply ?? '');
}

// ---- .env ---------------------------------------------------------------

/** Current value of key in ENV_FILE, with single quotes or a plain double-quoted value undone. */
function existing(key: string): string | undefined {
  if (!existsSync(ENV_FILE)) return undefined;
  const line = readFileSync(ENV_FILE, 'utf8').split('\n').filter((l) => l.startsWith(`${key}=`)).pop();
  if (line === undefined) return undefined;
  const value = line.slice(key.length + 1);
  if (value.length >= 2 && value.startsWith("'") && value.endsWith("'")) {
    return value.slice(1, -1).replaceAll("'\\''", "'");
  }
  if (value.length >= 2 && value.startsWith('"') && value.endsWith('"')) {
    const inner = value.slice(1, -1);
    return /[\\$"]/.test(inner) ? undefined : inner; // escapes, $ or ": can't decode safely; ask again
  }
  return value;
}

/** Values collected by ask/askSecret/writeEnv, read back with get(KEY). */
const values = new Map<string, string>();
const get = (key: string): string => values.get(key) ?? '';

async function ask(key: string, prompt: string): Promise<string> {
  const current = existing(key);
  const hint = current ? `${DIM}[Enter keeps current]${RESET} ` : '';
  const input = await readLine(`  ${BOLD}${prompt}${RESET} ${hint}`);
  if (input === null && !current) throw new Error(`no input for ${key}`);
  const value = input || current || '';
  values.set(key, value);
  return value;
}

async function askSecret(key: string, prompt: string): Promise<string> {
  const current = existing(key);
  const hint = current ? `${DIM}[Enter keeps current]${RESET} ` : '';
  const input = await readHidden(`  ${BOLD}${prompt}${RESET} ${hint}`);
  if (input === null && !current) throw new Error(`no input for ${key}`);
  const value = input || current || '';
  values.set(key, value);
  return value;
}

/** writeEnv upserts KEY='VALUE' into ENV_FILE (replacing any existing line). Idempotent; file mode 0600 when created. */
function writeEnv(key: string, value: string): void {
  const kept = existsSync(ENV_FILE)
    ? readFileSync(ENV_FILE, 'utf8').split('\n').filter((l) => l !== '' && !l.startsWith(`${key}=`))
    : [];
  kept.push(`${key}='${value.replaceAll("'", "'\\''")}'`);
  const fresh = !existsSync(ENV_FILE);
  writeFileSync(ENV_FILE, `${kept.join('\n')}\n`);
  if (fresh) chmodSync(ENV_FILE, 0o600);
  values.set(key, value);
  writtenEnv.push(key);
  out(`  ${GREEN}✓ wrote${RESET} ${key} → ${ENV_FILE}\n`);
}

// ---- GitHub Actions -----------------------------------------------------

function ghReady(): boolean {
  return !spawnSync('gh', ['auth', 'status'], { stdio: 'ignore' }).status;
}

/** setSecret sets a GitHub Actions repo secret via gh. Records a to-do if gh is unavailable. */
function setSecret(name: string, value: string): void {
  if (ghReady()) {
    try {
      execFileSync('gh', ['secret', 'set', name], { input: value, stdio: ['pipe', 'ignore', 'ignore'] });
      writtenSecret.push(name);
      out(`  ${GREEN}✓ set${RESET} GitHub secret ${name}\n`);
      return;
    } catch { /* fall through to the to-do */ }
  }
  skipped.push(`GitHub secret ${name} (set it manually: gh secret set ${name})`);
  warn(`skipped GitHub secret ${name}: gh not ready; set it later`);
}

/** setVar sets a GitHub Actions repo variable (non-secret). */
function setVar(name: string, value: string): void {
  if (ghReady()) {
    try {
      execFileSync('gh', ['variable', 'set', name, '--body', value], { stdio: 'ignore' });
      out(`  ${GREEN}✓ set${RESET} GitHub variable ${name}\n`);
      return;
    } catch { /* fall through to the to-do */ }
  }
  skipped.push(`GitHub variable ${name}`);
  warn(`skipped GitHub variable ${name}, gh not ready; set it later`);
}

/** finish clears, then shows a closing summary of everything configured. */
function finish(): void {
  clear();
  out(`\n${BOLD}${GREEN}  ✓ Setup complete${RESET}\n`);
  if (writtenEnv.length) note(`wrote ${writtenEnv.length} value(s) to ${ENV_FILE}: ${writtenEnv.join(' ')}`);
  if (writtenSecret.length) note(`set ${writtenSecret.length} GitHub secret(s): ${writtenSecret.join(' ')}`);
  if (skipped.length) {
    out('\n'); warn('still to do by hand:');
    for (const s of skipped) note(`  - ${s}`);
  }
  out('\n');
}

// ──────────────────────────────────────────────────────────────────────────
// STAGES: author this section. One stage() per step the human takes.
// Replace the example below. Set totalStages to match the stages you write.
// ──────────────────────────────────────────────────────────────────────────

async function runWizard(): Promise<void> {
  totalStages = 1;

  await banner('Stripe setup');

  // ── Example stage: replace with your real steps ─────────────────────────
  stage('Stripe: API keys');
  say("We'll grab your Stripe test keys and store them for local dev + CI.");
  openUrl('https://dashboard.stripe.com/test/apikeys');
  step('On the API keys page, copy the Publishable key (starts pk_test_).');
  await ask('STRIPE_PUBLISHABLE_KEY', 'Paste the publishable key:');
  step("Click 'Reveal test key' on the Secret key row, then copy it.");
  await askSecret('STRIPE_SECRET_KEY', 'Paste the secret key:');
  writeEnv('STRIPE_PUBLISHABLE_KEY', get('STRIPE_PUBLISHABLE_KEY'));
  writeEnv('STRIPE_SECRET_KEY', get('STRIPE_SECRET_KEY'));
  setSecret('STRIPE_SECRET_KEY', get('STRIPE_SECRET_KEY')); // CI needs this one
  // ────────────────────────────────────────────────────────────────────────

  finish();
}

// Unused helpers stay available for authors: confirm, setVar, say, step, note, warn.
void confirm; void setVar;

runWizard().then(() => process.exit(0), (e: unknown) => {
  out(`\n${YELLOW}✗ ${e instanceof Error ? e.message : String(e)}${RESET}\n`);
  process.exit(1);
});
